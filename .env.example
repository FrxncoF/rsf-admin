# Copiar a .env y completar:  cp .env.example .env

# --- Base de datos ---
POSTGRES_DB=rsf_admin
POSTGRES_USER=rsf
POSTGRES_PASSWORD=cambia_esta_clave

# --- Auth ---
# Generar con: openssl rand -hex 48
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_HOURS=12
# true SOLO cuando el sitio se sirva por HTTPS (recomendado en producción)
COOKIE_SECURE=false
# Orígenes permitidos por CORS (separados por coma). Vacío = solo mismo origen (Nginx)
CORS_ORIGINS=

# --- Usuario ADMIN inicial (se crea solo si no existe ningún ADMIN) ---
ADMIN_EMAIL=admin@residencia.cl
ADMIN_PASSWORD=cambia_esta_clave_admin
ADMIN_NAME=Administradora

# Cuenta SOPORTE inicial (opcional). Se crea al arrancar si no existe ninguna.
# Si el correo ya pertenece a un usuario (ej. tu cuenta ADMIN), se promueve a SOPORTE sin cambiar su clave.
SUPPORT_EMAIL=
SUPPORT_PASSWORD=
SUPPORT_NAME=Soporte

# Respaldos automáticos de la BD que se conservan (uno diario + los manuales)
BACKUP_KEEP=14

# --- Valor UF (opcional) ---
# API key gratuita de la CMF: https://api.cmfchile.cl/api_cmf/contactanos.jsp
# Si se deja vacía (o la CMF falla), la UF se obtiene de mindicador.cl.
APIKEYCMF=

# --- Correo saliente (Zoho Mail) ---
# Recomendado: API de Zoho por HTTPS (DigitalOcean bloquea los puertos SMTP 25/465/587).
# Crear un "Self Client" en https://api-console.zoho.com y obtener el refresh token con:
#   docker compose exec backend node src/scripts/zohoToken.js <código>
# Si estas 3 están completas se usa la API; si no, SMTP; si tampoco, los correos van a la consola.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Opcional: id de la cuenta (si se deja vacío se detecta solo) y centro de datos (.com, .eu, .in…)
ZOHO_ACCOUNT_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_URL=https://mail.zoho.com

# Dirección pública del sitio: se usa en los enlaces de los correos (ej. https://admin.tudominio.cl)
APP_URL=http://localhost
# Cuenta que inicia sesión en Zoho (dueña del alias) y su "contraseña de aplicación" de Zoho.
# Si se dejan vacías, los correos NO se envían: se muestran en la consola del backend (modo prueba).
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
# Remitente (alias de la cuenta anterior). Vacío = "Soporte Residencia San Francisco" <soporte@...>
MAIL_FROM=

# --- Varios ---
HTTP_PORT=80
TZ=America/Santiago

# --- Solo producción (docker-compose.prod.yml) ---
# El Nginx del sistema reenvía el dominio a este puerto local (deploy/nginx-admin.conf).
# En producción además: COOKIE_SECURE=true · TRUST_PROXY=2 (Nginx del sistema + Nginx del contenedor)
ADMIN_LOCAL_PORT=8080
TRUST_PROXY=1

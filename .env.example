# Copiar a .env y completar:  cp .env.example .env

# --- Base de datos ---
POSTGRES_DB=rsf_admin
POSTGRES_USER=rsf
POSTGRES_PASSWORD=cambia_esta_clave

# --- Auth ---
# Generar con: openssl rand -hex 48
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_HOURS=12
# true SOLO cuando el sitio se sirva por HTTPS (recomendado en producción)
COOKIE_SECURE=false
# Orígenes permitidos por CORS (separados por coma). Vacío = solo mismo origen (Nginx)
CORS_ORIGINS=

# --- Usuario ADMIN inicial (se crea solo si no existe ningún ADMIN) ---
ADMIN_EMAIL=admin@residencia.cl
ADMIN_PASSWORD=cambia_esta_clave_admin
ADMIN_NAME=Administradora

# --- Varios ---
HTTP_PORT=80
TZ=America/Santiago
